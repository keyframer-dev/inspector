  "description": "Sets up the Keyframer Inspector and Motion Vitals in a React Native or Expo app, step by step, and waits for the first message to prove it works",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "keyframer-wizard": "./bin/keyframer-wizard.mjs"
  },
