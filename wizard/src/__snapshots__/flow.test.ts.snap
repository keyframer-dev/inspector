  const dev = api.env('development');
  return {
    presets: ['module:@react-native/babel-preset'],
    plugins: [...(dev ? ['@keyframerdev/inspector/babel'] : []), '@keyframerdev/vitals/babel', 'react-native-worklets/plugin'],
  };
};
",
  "keyframer.ts": "/**
 * Keyframer, set up by @keyframerdev/wizard. Running the wizard again updates this file.
 * The Inspector runs in development builds only, shown in the Keyframer Inspector desktop app.
 * Motion Vitals reports slow frames and janky animations from every build: https://keyframer.dev/app/vitals
 * Docs: https://keyframer.dev/inspector/docs
 */
import {startVitals} from '@keyframerdev/vitals';
import {createNavigationContainerRef} from '@react-navigation/native';
import DeviceInfo from 'react-native-device-info';

/** On your NavigationContainer (ref={navigationRef}): screens are named from its routes. */
export const navigationRef = createNavigationContainerRef();

// The Inspector, in development only: \`require\` inside \`if (__DEV__)\` keeps it out of release builds.
if (__DEV__) {
  const {connectInspector} = require('@keyframerdev/inspector/native');
  const {trackNavigation} = require('@keyframerdev/inspector/record');
  // The desktop app's relay. On a phone, use the Mac's LAN address the app shows in its status bar.
  // On an Android emulator, run \`adb reverse tcp:8790 tcp:8790\` first.
  connectInspector({apiUrl: 'http://127.0.0.1:8790', code: 'DESKTOP', app: 'NavApp'});
  // Screen changes become markers in a recording, from the container's first state.
  let tracking = false;
  navigationRef.addListener('state', () => {
    if (tracking) return;
    tracking = true;
    trackNavigation(navigationRef);
  });
}

// The project's field key. It is public and write-only (it can only send reports to this project),
// so it is safe to ship in the app, like the docs show.
const VITALS_KEY = 'kfp_live_A1b2C3d4E5f6G7h8I9j0K1l2';

startVitals({
  key: VITALS_KEY,
  appVersion: DeviceInfo.getVersion(),
  build: DeviceInfo.getBuildNumber(),
  navigationRef,
});
