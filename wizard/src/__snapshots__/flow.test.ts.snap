  "app/_layout.tsx": "import FontAwesome from '@expo/vector-icons/FontAwesome';
import { DarkTheme, DefaultTheme, ThemeProvider } from '@react-navigation/native';
import { useFonts } from 'expo-font';
import { Stack, useNavigationContainerRef } from 'expo-router';
import * as SplashScreen from 'expo-splash-screen';
import { useEffect } from 'react';
import 'react-native-reanimated';

import { useColorScheme } from '@/components/useColorScheme';
import { useKeyframer } from '../keyframer';
import { VitalsRoot } from '@keyframerdev/vitals';

export {
  // Catch any errors thrown by the Layout component.
  ErrorBoundary,
} from 'expo-router';

export const unstable_settings = {
  // Ensure that reloading on \`/modal\` keeps a back button present.
  initialRouteName: '(tabs)',
};

// Prevent the splash screen from auto-hiding before asset loading is complete.
SplashScreen.preventAutoHideAsync();

export default function RootLayout() {
  const navigationRef = useNavigationContainerRef();
  useKeyframer(navigationRef);

  const [loaded, error] = useFonts({
    SpaceMono: require('../assets/fonts/SpaceMono-Regular.ttf'),
    ...FontAwesome.font,
  });

  // Expo Router uses Error Boundaries to catch errors in the navigation tree.
  useEffect(() => {
    if (error) throw error;
  }, [error]);

  useEffect(() => {
    if (loaded) {
      SplashScreen.hideAsync();
    }
  }, [loaded]);

  if (!loaded) {
    return null;
  }

  return (
    <VitalsRoot>
      <RootLayoutNav />
    </VitalsRoot>
  );
}

function RootLayoutNav() {
  const colorScheme = useColorScheme();

  return (
    <ThemeProvider value={colorScheme === 'dark' ? DarkTheme : DefaultTheme}>
      <Stack>
        <Stack.Screen name="(tabs)" options={{ headerShown: false }} />
        <Stack.Screen name="modal" options={{ presentation: 'modal' }} />
      </Stack>
    </ThemeProvider>
  );
}
",
  "babel.config.js": "module.exports = function (api) {
  api.cache.using(() => process.env.NODE_ENV)
  const dev = process.env.NODE_ENV !== 'production'
  return {
    presets: ['babel-preset-expo'],
    plugins: [...(dev ? ['@keyframerdev/inspector/babel'] : []), '@keyframerdev/vitals/babel'],
  }
}
",
  "keyframer.ts": "/**
 * Keyframer, set up by @keyframerdev/wizard. Running the wizard again updates this file.
 * The Inspector runs in development builds only, shown in Expo's dev tools (press shift+m in Metro, then open @keyframerdev/inspector).
 * Motion Vitals reports slow frames and janky animations from every build: https://keyframer.dev/app/vitals
 * Docs: https://keyframer.dev/inspector/docs
 */
import { startVitals, type NavigationRefLike } from '@keyframerdev/vitals';
import Constants from 'expo-constants';
import { useEffect } from 'react';
import { Platform } from 'react-native';

// The Inspector, in development only: \`require\` inside \`if (__DEV__)\` keeps it out of release builds.
if (__DEV__) {
  const { connectDevTools } = require('@keyframerdev/inspector/devtools');
  connectDevTools({ app: 'Tabs App' });
}

// The project's field key. It is public and write-only (it can only send reports to this project),
// so it is safe to ship in the app, like the docs show.
const VITALS_KEY = 'kfp_live_A1b2C3d4E5f6G7h8I9j0K1l2';
const build = Platform.OS === 'ios' ? Constants.platform?.ios?.buildNumber : Constants.expoConfig?.android?.versionCode;

/** Call once in app/_layout.tsx, with the navigation container's ref: screens are named from its routes. */
export function useKeyframer(navigationRef: NavigationRefLike) {
  useEffect(() => {
    startVitals({
      key: VITALS_KEY,
      appVersion: Constants.expoConfig?.version ?? '0',
      build: build == null ? undefined : String(build),
      navigationRef,
    });
  }, [navigationRef]);
  useEffect(() => {
    // Screen changes become markers in an Inspector recording.
    if (__DEV__) return require('@keyframerdev/inspector/record').trackNavigation(navigationRef);
  }, [navigationRef]);
}
",
