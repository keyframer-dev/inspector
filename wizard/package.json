    "terminal-svg": "bun scripts/terminal-svg.ts"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/types": "^7.29.0",
    "@clack/prompts": "^1.8.1",
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.2",
    "recast": "^0.24.0",
    "typescript": "~6.0.3",
    "vitest": "^3.0.5",
    "ws": "^8.22.0"
  }
}
