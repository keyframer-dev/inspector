const Stack = createNativeStackNavigator();

function App(): React.JSX.Element {
  return (
    <NavigationContainer
      ref={navigationRef}
      theme={DefaultTheme}
      onReady={() => console.log('navigation ready')}>
      <Stack.Navigator>
        <Stack.Screen name="Home" component={HomeScreen} />
        <Stack.Screen name="Details" component={DetailsScreen} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}

export default App;
",
